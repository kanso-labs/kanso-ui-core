{
  "name": "@kanso-labs/kanso-ui-core",
  "version": "0.1.1",
  "description": "The design data Kanso UI's web and React Native libraries share: the design tokens, the demo schemes and the glyph paths",
  "keywords": [
    "design-system",
    "design-tokens",
    "material-design",
    "kanso-ui"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./glyphs": {
      "types": "./dist/glyphs.d.ts",
      "default": "./dist/glyphs.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./tokens.css": {
      "types": "./dist/stylesheet.d.ts",
      "default": "./dist/tokens.css"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/kanso-ui-core.git"
  },
  "scripts": {
    "build": "npm run tokens:build && tsc -b && tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run tokens:build && oxlint --type-aware . && eslint . && npm run format:check",
    "package:check": "publint && attw --pack --profile esm-only",
    "prepare": "husky || true",
    "test": "npm run tokens:build && vitest run",
    "test:coverage": "npm run tokens:build && vitest run --coverage",
    "tokens:build": "node scripts/build-tokens.mjs"
  },
  "author": "Kanso Labs <kanso.labs.org@gmail.com>",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codecov/rollup-plugin": "2.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.89.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "style-dictionary": "5.7.0",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint-plugin-oxlint": {
      "oxlint": "$oxlint"
    }
  }
}
